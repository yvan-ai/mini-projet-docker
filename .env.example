# Copier ce fichier en .env puis adapter les valeurs.
# Nom de la base créée au premier démarrage de PostgreSQL
POSTGRES_DB=todo
# Utilisateur propriétaire de la base
POSTGRES_USER=todo
# Mot de passe de cet utilisateur (à changer)
POSTGRES_PASSWORD=change_me
# Port de l'hôte sur lequel le reverse proxy est publié
HTTP_PORT=8080
